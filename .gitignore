# ==========================================
# Unreal Engine Core Folders to Ignore
# ==========================================
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/

# Ignore plugin-specific generated folders
Plugins/*/Binaries/
Plugins/*/Intermediate/
Plugins/*/Saved/
Plugins/**/Binaries/
Plugins/**/Intermediate/
Plugins/**/Saved/

# ==========================================
# Whitelists (Do NOT ignore these)
# ==========================================
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# ==========================================
# Map Built Data
# ==========================================
# Uncomment the line below if you want to ignore auto-generated map build data
# *_BuiltData.uasset

# ==========================================
# Source Control & IDE Files
# ==========================================
# Visual Studio
.vs/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.VC.db-wal
*.VC.db-shm

# Visual Studio Code
.vscode/

# Rider / JetBrains
.idea/

# Xcode (Mac)
*.xcodeproj
*.xcworkspace

# ==========================================
# Compiled Binaries & OS Junk
# ==========================================
*.slo
*.lo
*.o
*.obj
*.gch
*.pch
*.so
*.dylib
*.dll
*.lib
*.exe
*.out
*.app
*.ipa

# OS specific
.DS_Store
Thumbs.db
